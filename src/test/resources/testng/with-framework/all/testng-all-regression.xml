<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Sregression all tests" verbose="1" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"></listener>
        <listener class-name="org.bps.testsetup.RetryListener"></listener>
    </listeners>
    <test name="login page">
        <parameter name="browser" value="SAFARI"/>
        <classes>
            <class name="org.bps.seleniumwebapp.SeleniumWebTests" />
        </classes>
    </test>
    <test name="todo page">
        <parameter name="browser" value="CHROME"/>
        <classes>
            <class name="org.bps.todoapp.TodoAppTest"/>
        </classes>
    </test>
</suite>